<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cologne World</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        /* CSS Variables */
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #e74c3c;
            --accent-color: #3498db;
            --light-color: #ecf0f1;
            --dark-color: #2c3e50;
        }

        /* Base Styles */
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
            margin: 0;
            padding: 0;
        }

        /* Navigation */
        .navbar-custom {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

        .navbar-brand-custom {
            font-family: 'Inter', sans-serif;
            font-weight: 700;
            font-size: 1.8rem;
            color: var(--secondary-color);
        }

        .nav-link-custom {
            font-weight: 500;
            color: var(--dark-color);
            margin: 0 10px;
            position: relative;
        }

            .nav-link-custom:hover {
                color: var(--secondary-color);
            }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(rgba(44, 62, 80, 0.8), rgba(231, 76, 60, 0.7)), url('https://images.unsplash.com/photo-1544441893-675973e31985?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 120px 0;
            text-align: center;
        }

        /* Product Cards */
        .product-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: none;
            transition: all 0.3s ease;
        }

            .product-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            }

        .product-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 15px;
        }

        .price-tag {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--secondary-color);
        }

        /* Buttons */
        .btn-primary-custom {
            background: linear-gradient(45deg, var(--secondary-color), var(--accent-color));
            border: none;
            border-radius: 25px;
            padding: 12px 30px;
            font-weight: 600;
            color: white;
            transition: all 0.3s ease;
        }

            .btn-primary-custom:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(231, 76, 60, 0.3);
                color: white;
            }

        /* Cart Badge */
        .cart-badge {
            background: var(--secondary-color);
            color: white;
            border-radius: 50%;
            padding: 4px 8px;
            font-size: 0.7rem;
            margin-left: 5px;
        }

        /* Footer */
        .footer-custom {
            background: var(--dark-color);
            color: var(--light-color);
            padding: 40px 0;
            margin-top: 80px;
        }

        /* Animations */
        .fade-in {
            opacity: 0;
            animation: fadeIn 1s ease-in forwards;
        }

        .slide-up {
            opacity: 0;
            transform: translateY(30px);
            animation: slideUp 0.8s ease-out forwards;
        }

        /* Keyframes - Fixed Syntax */
        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .hero-section {
                padding: 80px 0;
            }

            .navbar-brand-custom {
                font-size: 1.4rem;
            }
        }
    </style>
</head>
<body>
   
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container">
            <a class="navbar-brand navbar-brand-custom" asp-controller="Home" asp-action="Index">
                <i class="fas fa-gem me-2"></i>Cologne World
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Products" asp-action="Index">Products</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" asp-controller="Cart" asp-action="Index">
                            <i class="fas fa-shopping-cart"></i> Cart
                            @{
                                var cartJson = Context.Session.GetString("ShoppingCart");
                                if (!string.IsNullOrEmpty(cartJson))
                                {
                                    try
                                    {
                                        var cart = System.Text.Json.JsonSerializer.Deserialize<CologneWorld.Models.ShoppingCart>(cartJson);
                                        var itemCount = cart?.GetTotalItems() ?? 0;
                                        if (itemCount > 0)
                                        {
                                            <span class="cart-badge">@itemCount</span>
                                        }
                                    }
                                    catch
                                    {
                                        // If deserialization fails, don't show badge
                                    }
                                }
                            }
                        </a>
                    </li>
                </ul>

                <!-- Login/Register or User Profile Section -->
                <ul class="navbar-nav ms-auto">
                    @if (Context.Session.GetString("UserId") != null)
                    {
                        <!-- User is logged in -->
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-link-custom dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user me-1"></i>@Context.Session.GetString("UserName")
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#"><i class="fas fa-user me-2"></i>Profile</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fas fa-history me-2"></i>Order History</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <!-- User is not logged in -->
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary-custom btn-sm ms-2" asp-controller="Account" asp-action="Register">
                                <i class="fas fa-user-plus me-1"></i>Sign Up
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <!-- Main Content -->
    <main style="padding-top: 80px;">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5><i class="fas fa-gem me-2"></i>Cologne World</h5>
                    <p>Your premier destination for luxury fragrances and premium colognes. Experience elegance in every scent.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p>&copy; 2024 Cologne World. All rights reserved.</p>
                    <p>Designed for fragrance enthusiasts</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Add to cart animation
        function addToCartAnimation(button) {
            const originalText = button.innerHTML;
            const originalClass = button.className;

            button.innerHTML = '<i class="fas fa-check"></i> Added to Cart!';
            button.className = 'btn btn-success';
            button.disabled = true;

            // Force page refresh to update cart counter
            setTimeout(() => {
                button.innerHTML = originalText;
                button.className = originalClass;
                button.disabled = false;
                // Refresh the page to update cart counter
                setTimeout(() => {
                    window.location.reload();
                }, 500);
            }, 1500);
        }

        // Navbar scroll effect
        $(window).scroll(function() {
            if ($(window).scrollTop() > 50) {
                $('.navbar-custom').css('background', 'rgba(255, 255, 255, 0.98)');
            } else {
                $('.navbar-custom').css('background', 'rgba(255, 255, 255, 0.95)');
            }
        });

        // Initialize animations
        document.addEventListener('DOMContentLoaded', function() {
            // Add fade-in class to elements for animation
            document.querySelectorAll('.product-card').forEach(card => {
                card.classList.add('fade-in');
            });
        });

        // Auto-refresh cart counter every 2 seconds
        setInterval(function() {
            // This ensures the cart counter stays updated
            var cartLinks = document.querySelectorAll('a[href*="Cart"]');
            cartLinks.forEach(link => {
                // Force re-render of cart counter
                link.innerHTML = link.innerHTML;
            });
        }, 2000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>