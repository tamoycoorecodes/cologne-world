@{
    ViewData["Title"] = "About Us - Cologne World";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="display-3 fw-bold mb-4 animate-slide-up">About Cologne World</h1>
            <p class="lead mb-5 animate-fade-in">
                Welcome to Cologne World, your premier destination for luxury fragrances and premium colognes.
                We curate the finest collection of scents from around the world, bringing you exceptional quality and unforgettable aromas.
            </p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-6 mb-4 animate-fade-in">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="fas fa-award feature-icon"></i>
                    <h4 class="fw-bold mt-3">Premium Quality</h4>
                    <p class="text-muted">Every fragrance in our collection is carefully selected for its quality, authenticity, and lasting impression. We work directly with renowned brands to ensure you receive only the best.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4 animate-fade-in">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="fas fa-globe feature-icon"></i>
                    <h4 class="fw-bold mt-3">Global Selection</h4>
                    <p class="text-muted">We source the finest colognes from renowned brands worldwide, offering you a diverse collection that caters to every preference and occasion.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4 animate-fade-in">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="fas fa-heart feature-icon"></i>
                    <h4 class="fw-bold mt-3">Customer Love</h4>
                    <p class="text-muted">Join thousands of satisfied customers who trust us for their fragrance needs. Our commitment to excellence has made us a trusted name in luxury fragrances.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4 animate-fade-in">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="fas fa-gem feature-icon"></i>
                    <h4 class="fw-bold mt-3">Luxury Experience</h4>
                    <p class="text-muted">From our carefully designed packaging to our personalized customer service, we ensure every aspect of your Cologne World experience reflects luxury and sophistication.</p>
                </div>
            </div>
        </div>
    </div>
</div>